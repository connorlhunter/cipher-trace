# Runtime mode only. Do not add production identifiers, tokens, document keys,
# plaintext data, or any value that would permit a service to decrypt a document.
CIPHER_TRACE_ENVIRONMENT=local

# The deployed API must validate issuer, audience, and JWKS settings. The
# skeleton leaves them intentionally empty until infrastructure is defined.
CIPHER_TRACE_COGNITO_ISSUER=
CIPHER_TRACE_COGNITO_AUDIENCE=
